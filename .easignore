# Replaces .gitignore for EAS uploads, so the rules from it are repeated here.
# Keep both files in sync.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native (regenerated by prebuild on EAS)
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
supabase/functions/.env

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# e2e
/build/
supabase/functions/.env.e2e
__pycache__/

# Not needed to build the app
/Maestro/
/scripts/e2e/
/scripts/smoke/
/supabase/
/site/
/.vscode/
/design-overhaul-audit.md
/README.md
